+/**
+ * Identity of a host open target in the tree (0.9.2 directory location). A directory the host references exists,
+ * and opening it means expanding and listing its content, not passing the directory to a file read (fm.read
+ * reports INVALID_PATH for directories). Only an **already loaded** parent listing is trusted: exact match by path.
+ * Without a listing (not listed yet / just changed externally) it returns "unknown" and the caller treats it as a file;
+ * the read failure report is accurate anyway, so stay conservative rather than guess.
+ */
+export type HostOpenTargetKind = "file" | "directory" | "unknown";
+
+export function classifyHostOpenTarget(
+  relPath: string,
+  listing: readonly { path: string; isDirectory: boolean }[] | undefined,
+): HostOpenTargetKind {
+  const entry = listing?.find((candidate) => candidate.path === relPath);
+  if (!entry) return "unknown";
+  return entry.isDirectory ? "directory" : "file";
+}
+
 /**
  * 订阅两条投递路径，把去重后的请求交给 onRequest。返回取消函数。
  */
