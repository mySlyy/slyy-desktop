       return t("sqliteOffsetLimit");
     case "GIT_UNAVAILABLE":
       return t("gitUnavailable");
+    case "INVALID_PATH":
+      // Directories never go to a file read (the shared refusal of fm.read / fm.write). When the host opens a directory
+      // location this failure is the normal path; translate it into plain language instead of the bare English message.
+      if (failure.message === "path is a directory") return t("errIsDirectory");
+      return failure.message || failure.code;
     default:
       // SQLITE_SQL_ERROR 走这里：引擎自己的报错（no such table: …）就是最有用的文案
       return failure.message || failure.code;
diff --git a/views-src/verify-host-open.mjs b/views-src/verify-host-open.mjs
new file mode 100644
index 0000000..dd5ef64
--- /dev/null
+++ b/views-src/verify-host-open.mjs
@@ -0,0 +1,114 @@
+/**
+ * Offline check for host-opened directory locations (0.9.2).
+ *
+ * Directories referenced by the host (Desktop's chat panel) used to be passed to fm.read too; the main process always
+ * answered INVALID_PATH "path is a directory", and the view could only show a bare English sentence: a directory
+ * reference was an operation bound to fail. After the fix the view classifies the target from the parent listing:
+ * directory → expand and list its content; file → preview as before; no listing → treat as a file conservatively.
+ * This asserts the pure classification in lib/hostOpen.ts and the translation of that failure in lib/rpc.ts,
+ * without a DOM (the same approach as verify-roots.mjs).
+ *
+ * Usage: pnpm verify:host-open
+ */
+
+import { build } from "esbuild";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+async function loadModules(specifiers) {
+  const dir = mkdtempSync(join(tmpdir(), "pifm-host-open-"));
+  const entry = join(dir, "entry.ts");
+  const out = join(dir, "bundle.mjs");
+  const exports = specifiers
+    .map(([name, file]) => `import * as ${name} from ${JSON.stringify(join(here, "src", file))};\nexport { ${name} };`)
+    .join("");
+  writeFileSync(entry, exports);
+
+  await build({
+    entryPoints: [entry],
+    bundle: true,
+    format: "esm",
+    platform: "node",
+    outfile: out,
+    logLevel: "silent",
+  });
+
+  return import(pathToFileURL(out).href);
+}
+
+let failures = 0;
+function check(label, condition, detail = "") {
+  if (condition) {
+    console.log(`ok   ${label}`);
+    return;
+  }
+  failures += 1;
+  console.log(`FAIL ${label} ${detail}`);
+}
+
+const { hostOpen, rpc, i18n } = await loadModules([
+  ["hostOpen", join("lib", "hostOpen.ts")],
+  ["rpc", join("lib", "rpc.ts")],
+  ["i18n", join("i18n.ts")],
+]);
+
+const LISTING = [
+  { path: "examples", isDirectory: true },
+  { path: "test.ts", isDirectory: false },
+  { path: "src/dir/openimage.js", isDirectory: false },
+];
+
+console.log("1. classifyHostOpenTarget (parent listing loaded)");
+check(
+  "directory entry classified as directory",
+  hostOpen.classifyHostOpenTarget("examples", LISTING) === "directory",
+);
+check(
+  "file entry classified as file",
+  hostOpen.classifyHostOpenTarget("test.ts", LISTING) === "file",
+);
+check(
+  "multi-segment paths match the full relative path exactly, no suffix guessing",
+  hostOpen.classifyHostOpenTarget("src/dir/openimage.js", LISTING) === "file" &&
+    hostOpen.classifyHostOpenTarget("dir/openimage.js", LISTING) === "unknown",
+);
+check(
+  "no listing (not loaded / invalidated) is treated conservatively as unknown",
+  hostOpen.classifyHostOpenTarget("examples", undefined) === "unknown" &&
+    hostOpen.classifyHostOpenTarget("examples", []) === "unknown",
+);
+
+console.log("2. failureMessage turns the directory read failure into plain language");
+const t = (key) => {
+  const table = {
+    errIsDirectory: "That path is a directory; folders are browsed in the tree, and only inside the project.",
+  };
+  return table[key] ?? key;
+};
+check(
+  'fm.read INVALID_PATH "path is a directory" gets its dedicated message',
+  rpc.failureMessage({ ok: false, code: "INVALID_PATH", message: "path is a directory" }, t) ===
+    t("errIsDirectory"),
+);
+check(
+  "other INVALID_PATH failures still return the main process's own message",
+  rpc.failureMessage({ ok: false, code: "INVALID_PATH", message: "path must be a string" }, t) ===
+    "path must be a string",
+);
+
+console.log("3. en and zh copy keys stay aligned (errIsDirectory in both)");
+check(
+  "en and zh both have errIsDirectory",
+  typeof i18n.COPY_TABLES.en.errIsDirectory === "string" &&
+    typeof i18n.COPY_TABLES.zh.errIsDirectory === "string",
+);
+
+if (failures > 0) {
+  console.log(`\n${failures} check(s) failed`);
+  process.exit(1);
+}
+console.log("\nall checks passed");
